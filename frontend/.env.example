# Base URL of the FastAPI backend. Leave EMPTY in local dev (Vite proxies /api to localhost:8000).
# On Vercel set it to your Render URL, e.g. https://travel-planner-api.onrender.com
VITE_API_URL=

# Supabase project (Settings -> API). Leave empty to run in guest mode without login.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
