# ---- Generative AI (Groq). Leave empty to run the built-in Demo planner.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Unsplash cover photos. Leave empty for gradient placeholders.
UNSPLASH_ACCESS_KEY=

# ---- Supabase (auth + trips table). Leave both empty for guest mode with local SQLite.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---- Browser origins allowed to call this API (comma separated). Add your Vercel URL after deploying.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI calls allowed per user/guest per hour
RATE_LIMIT_PER_HOUR=20
